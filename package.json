{
  "name": "scopeforge",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "scopeforge": ".scopeforge-build/packages/cli/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "NODE_ENV=test npx vitest run tests/components/attack-surface-v5-quality.test.ts tests/components/attack-surface-v5-geometry.test.ts tests/components/attack-surface-v5-animation.test.ts tests/components/attack-surface-v5-controller.test.ts",
    "build": "NEXT_PUBLIC_SUPABASE_URL=https://acceptance.invalid NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_scopeforge_visual_review NODE_ENV=production next build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "scopeforge": "npm run build:cli --silent && node .scopeforge-build/packages/cli/index.js",
    "benchmark:scanner": "node benchmarks/scanner-medium.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cdktf/hcl2json": "0.21.0",
    "@cyclonedx/cyclonedx-library": "10.2.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.55.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
