NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase secret key. Never expose this in browser code or prefix it with NEXT_PUBLIC_.
# Required for trusted verification-state writes after proof-of-control succeeds.
SUPABASE_SECRET_KEY=

# Bot-abuse integration. Leave blank until a Turnstile widget is provisioned.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub connected projects. The feature gate is deliberately default-off.
# Configure the six GitHub App values server-side, complete production provider acceptance,
# then set HOSTED_GITHUB_INTEGRATION_ENABLED=true. Do not prefix any GitHub secret with NEXT_PUBLIC_.
HOSTED_GITHUB_INTEGRATION_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_STATE_SECRET=

# Private R2 artifact storage. These credentials are server-only and must never be exposed to browser code.
# Repository acquisition uses them only from trusted server composition to mint bounded artifact capabilities
# and perform reviewed object lifecycle operations.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=scopeforge-artifacts

# GitHub App connected-project integration. Every value below is server-only.
# Keep the OAuth client secret, App private key, state secret, and webhook secret independent.
GITHUB_APP_WEBHOOK_SECRET=

# Hosted runtime gates. Safe default is false/absent. Do not enable a gate merely because code or CI is green;
# each execution class requires its own production deployment, containment, canary, and rollback acceptance.
HOSTED_REPOSITORY_SNAPSHOT_RUNTIME_ENABLED=false
HOSTED_PRIVATE_REPOSITORY_SNAPSHOT_RUNTIME_ENABLED=false
HOSTED_REPOSITORY_SCAN_RUNTIME_ENABLED=false
HOSTED_PASSIVE_RUNTIME_WORKER_ENABLED=false
HOSTED_ACTIVE_CORS_WORKER_ENABLED=false
